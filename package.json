    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "isbot": "^5.2.3",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.6",
    "monaco-editor": "^0.55.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.12.0",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
