    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/youtube": "^0.1.2",
    "ai-hero-cli": "^0.4.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.10.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
